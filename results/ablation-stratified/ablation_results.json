    "deterministic": true,
    "detect_pad_ratio": 0.5,
    "fake_total": 500,
    "stratified_fakes": true,
    "real_fake_ratio": "500:500",
    "backbones": {
      "ViT-16": "google/vit-base-patch16-224",
      "ViT-32": "google/vit-base-patch32-224-in21k",
      "Swin-Tiny": "microsoft/swin-tiny-patch4-window7-224"
    },
    "detectors": [
      "retinaface",
      "mtcnn"
    ],
    "anchor_cell": "retinaface+ViT-16",
    "protocol": "frozen pretrained backbones; trainable fusion head; identity-disjoint StratifiedGroupKFold on FakeAVCeleb id00XXX",
    "notes": [
      "ViT-32 uses google/vit-base-patch32-224-in21k: google/vit-base-patch32-224 does not exist on the Hub. ViT-16 is in21k->in1k, ViT-32 is in21k-only.",
      "Backbones are frozen, so results measure representation quality, not fine-tuning behaviour.",
      "detect_pad_ratio=0.5 pads the frame before detection. FakeAVCeleb ships 224x224 pre-cropped faces that fill the frame, which falls outside RetinaFace's anchor scales: unpadded it detects ~34-54% of frames vs MTCNN's 100%, purely as a configuration artifact. Padding is applied identically to both detectors.",
      "Fakes drawn evenly across the three sub-categories (face-swap / lip-sync / both). Stratifying lifts the audio-only (lip-sync) class from ~2.4% to a testable share; see per_category_auc for the audio-branch result.",
      "All videos span the same 500 identities regardless of count, so more videos add coverage, not statistical power."
    ]
  },
